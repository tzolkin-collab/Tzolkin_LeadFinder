datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── PLATFORM & GOVERNANCE (TZOLKIN GLOBAL) ──────────────────────────

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  AUDITOR
}

model PlatformAdmin {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         PlatformRole @default(ADMIN)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  auditLogs AdminAuditLog[]

  @@map("platform_admins")
}

enum AssetService {
  GOOGLE_PLACES
  SERPER
  OPENAI
  META_ADS
  EVOLUTION_API
  STRIPE
  CUSTOM_DOMAIN
}

enum AssetType {
  API_KEY
  OAUTH_TOKEN
  DOMAIN
  WEBHOOK
  CREDENTIAL
}

model SystemAsset {
  id        String       @id @default(cuid())
  name      String // ex: "Google Places API Key Primary", "Domínio SaaS Principal"
  service   AssetService
  assetType AssetType
  value     String // Encrypted secret value, API token or domain URL
  isShared  Boolean      @default(true)
  tenantId  String? // Optional: if asset is dedicated to a specific tenant
  tenant    Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status    String       @default("ACTIVE") // "ACTIVE", "ROTATED", "DISABLED"
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("system_assets")
}

model AdminAuditLog {
  id        String        @id @default(cuid())
  adminId   String
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String // "CREATE_TENANT", "ROTATE_ASSET", "UPDATE_PERMISSIONS"
  resource  String
  ipAddress String?
  details   Json?
  createdAt DateTime      @default(now())

  @@map("admin_audit_logs")
}

// ─── MULTI-TENANT SAAS DATA MODEL ─────────────────────────────────────

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

// O que o USUÁRIO PAGANTE faz — não confundir com o ICP dele (abaixo), que é
// para quem ele vende. Sem isto o produto não sabe o que mostrar: um designer
// não se importa se o alvo tem site, um gestor de tráfego se importa com quem
// anuncia sem landing page. É o eixo de relevância de todo o resto.
//
// Array, não valor único: freelancer produtizado real acumula especialidade
// ("faço site e tráfego"), e forçar escolha única produziria perfil errado.
enum ProviderSpecialty {
  DESENVOLVIMENTO_WEB // sites, landing pages, sistemas
  TRAFEGO_PAGO // Meta/Google/TikTok Ads
  SOCIAL_MEDIA // gestão de redes, conteúdo orgânico
  DESIGN_BRANDING // identidade visual, material gráfico
  AUTOMACAO_IA // automação de atendimento, agentes, integrações
  SEO_CONTEUDO // busca orgânica, blog, autoridade
  CONSULTORIA_ESTRATEGIA // diagnóstico, posicionamento, gestão
  OUTRO // ver specialtyOther
}

// ─── TAXONOMIA DE SERVIÇO (CATEGORIA FIXA + SUBCATEGORIA CONTROLADA) ──
//
// Categoria é enum de propósito: poucos valores, estável, muda só por decisão
// humana com migration. Subcategoria é TABELA porque o mercado inventa serviço
// toda semana ("automação de IA para inbound" não existia dois anos atrás) e
// enum não cresce sem deploy.
//
// ⚠️ Tabela que cresce é onde nasce explosão de categoria. Todo o controle está
// em `service-taxonomy.service.ts` — nada escreve aqui direto. Os limites são
// numéricos e provados em teste: teto de ACTIVE por categoria, teto de PENDING,
// rate limit por tenant e limiar de confirmação para promover.

enum ServiceCategory {
  MARKETING_DIGITAL
  DESENVOLVIMENTO
  DESIGN
  AUTOMACAO_IA
  CONSULTORIA
}

enum TaxonomyStatus {
  PENDING // proposta em quarentena — NÃO aparece como opção escolhível
  ACTIVE // canônica, utilizável
  MERGED // absorvida por outra; seguir mergedIntoId
  REJECTED // revisada e recusada. Existe para que re-propor o mesmo termo seja
  // no-op em vez de criar linha nova — é o que faz a contagem convergir.
}

model ServiceSubcategory {
  id       String          @id @default(cuid())
  category ServiceCategory

  slug  String @unique // normalizado, sem acento: "trafego-pago"
  label String // exibição: "Tráfego pago"

  // Sinônimos absorvidos ("midia paga", "gestao de trafego", "google ads").
  // A taxonomia cresce em ALIAS (barato) em vez de em linha (caro).
  aliases String[]

  status TaxonomyStatus @default(PENDING)

  // Ponte para o mapa de relevância (packages/core/specialty-relevance).
  // null = subcategoria nova sem relevância mapeada; o produto diz isso em vez
  // de inventar sinal relevante.
  providerSpecialty ProviderSpecialty?

  // Fontes independentes que propuseram — mesma lógica de
  // CanonicalField.confirmations. Ao cruzar o limiar, promove para ACTIVE.
  confirmations Int @default(1)

  // Dedup de confirmação: o mesmo tenant propondo 3x não vale 3 confirmações.
  // ⚠️ Interno, como observerCount — NUNCA chega à interface.
  proposedByTenantIds String[]

  mergedIntoId String?
  mergedInto   ServiceSubcategory?  @relation("SubcategoryMerge", fields: [mergedIntoId], references: [id])
  absorbed     ServiceSubcategory[] @relation("SubcategoryMerge")

  tenants TenantService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, status])
  @@index([status, confirmations])
  @@map("service_subcategories")
}

// O que este tenant presta, na granularidade de profissão-dentro-do-nicho.
//
// Relação e não array de enum porque "todos podem prestar mais de um serviço e
// atender a mais de um nicho": o mesmo prestador pode ter landing page
// (DESENVOLVIMENTO) e tráfego pago (MARKETING_DIGITAL) ao mesmo tempo, e a
// categoria vem da própria subcategoria — sem risco de o par ficar
// inconsistente.
//
// `Tenant.specialties` deixa de ser fonte de verdade: a especialidade é
// DERIVADA daqui via `ServiceSubcategory.providerSpecialty`. Ver
// `tenantServiceProfile()`.
model TenantService {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcategoryId String
  subcategory   ServiceSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantId, subcategoryId])
  @@index([tenantId])
  @@map("tenant_services")
}

model Tenant {
  id     String       @id @default(cuid())
  slug   String       @unique
  name   String
  plan   TenantPlan   @default(STARTER)
  status TenantStatus @default(ACTIVE)

  // 👤 PERFIL DO PRESTADOR (O QUE EU FAÇO — dirige toda a relevância)
  //
  // ⚠️ `specialties` é CACHE DERIVADO de `services` (via
  // ServiceSubcategory.providerSpecialty). A fonte de verdade é a relação —
  // ela carrega nicho + profissão, que é a granularidade que o produto pede.
  // Não escrever aqui direto: usar `setTenantServices()`, que recalcula.
  specialties    ProviderSpecialty[]
  specialtyOther String? // texto livre quando a profissão ainda não tem subcategoria

  services TenantService[]

  // 🎯 ICP (Perfil de Cliente Ideal - QUEM É O CLIENTE)
  icpNiche         String? // Segmento/Nicho Alvo (ex: "Clínicas Médicas e Odontológicas")
  icpRegion        String? // Região ou Porte (ex: "Capitais e Regiões Metropolitanas do SE/SUL")
  icpDecisionMaker String? // Cargos dos Decisores (ex: "Diretor Clínico, Sócio Proprietário")
  icpPainPoints    String? // Dores e Desafios (ex: "Dependência de indicações, falta de presença digital")

  // 🚀 PROPOSTA DE VALOR (O QUE E COMO RESOLVE)
  valuePropHeadline      String? // Promessa Principal (ex: "Transformamos clínicas em referência digital gerando 3x mais agendamentos")
  valuePropServices      String? // Serviços & Soluções (ex: "Criação de Sites de Alta Conversão, Google Ads, SEO Local, Meta Ads")
  valuePropDifferentials String? // Diferenciais Únicos (ex: "Entrega em 7 dias, garantia de performance, suporte dedicado")

  selectedAiModel  String   @default("gpt-4o-mini") // "gpt-4o-mini", "gpt-4o", "claude-3-5-sonnet"
  subscriptionPlan String   @default("starter") // "starter", "pro"
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users      User[]
  businesses Business[]
  apiKeys    ApiKey[]
  assets     SystemAsset[]

  @@map("tenants")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@map("users")
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String // ex: "Integração CRM Maior B2B"
  keyHash    String    @unique // Hash SHA-256 da chave de API
  keyPrefix  String // ex: "tz_live_..."
  scopes     String[] // ["leads:read", "leads:write", "search:execute"]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("api_keys")
}

model Business {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  placeId             String
  name                String
  address             String?
  phone               String?
  category            String?
  rating              Float?
  reviewCount         Int?
  hasWebsite          Boolean   @default(false)
  websiteUrl          String?
  googleMapsUrl       String?
  latitude            Float?
  longitude           Float?
  photos              String[]
  openingHours        String?
  searchQuery         String?
  cnpj                String?
  razaoSocial         String?
  nomeFantasia        String?
  situacaoCadastral   String?
  dataInicioAtividade DateTime?
  cnaeDescricao       String?
  capitalSocial       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  report BusinessReport?

  // Link para o cadastro canônico compartilhado. Opcional durante a migração:
  // registros antigos sobem para a base master conforme forem observados.
  canonicalId String?
  canonical   CanonicalBusiness? @relation(fields: [canonicalId], references: [id], onDelete: SetNull)

  @@unique([tenantId, placeId])
  @@index([tenantId])
  @@index([canonicalId])
  @@map("businesses")
}

enum ReportStatus {
  PENDING
  REVIEWED
  CONTACTED
  REJECTED
}

model BusinessReport {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  instagramUrl       String?
  instagramBio       String?
  instagramFollowers String?
  instagramPosts     Int?
  profilePicUrl      String?

  brandColors         String[]
  visualIdentityNotes String?

  aiAnalysis         Json?
  cnpjAnalysis       Json?
  adsAuditAnalysis   Json?
  suitabilityScore   Int     @default(5)
  aiSummary          String?
  approachSuggestion String?

  websiteScreenshotUrl   String?
  instagramScreenshotUrl String?
  scrapedCodeUrl         String?

  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("business_reports")
}

// ─── BASE MASTER CANÔNICA (COMPARTILHADA ENTRE TENANTS) ──────────────
//
// Toda pesquisa paga por um tenant escreve aqui. O cadastro não é
// re-coletado do zero por quem chega depois — é conferido e ganha
// confiança a cada observação independente que concorda com a anterior.
//
// Regra de fronteira: aqui só entra DADO COMERCIAL PÚBLICO observado
// (Maps, site, Instagram, Meta Ads, Receita). Análise calibrada no ICP
// do tenant, conteúdo de chat e copy do usuário NÃO entram — ficam em
// BusinessReport / Conversa, que são privados por tenant.

model CanonicalBusiness {
  id String @id @default(cuid())

  placeId String? @unique
  cnpj    String? @unique

  name      String
  address   String?
  city      String?
  state     String?
  category  String?
  cnaeCode  String?
  latitude  Float?
  longitude Float?

  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())

  // Quantos tenants distintos já observaram este negócio. Alimenta a
  // confiança agregada — NUNCA é exposto na interface do usuário.
  observerCount Int @default(0)

  observations  Observation[]
  signals       Signal[]
  fields        CanonicalField[]
  tenantRecords Business[]
  lists         LeadListEntry[]

  @@index([city, category])
  @@index([lastObservedAt])
  @@map("canonical_businesses")
}

enum ObservationSource {
  GOOGLE_PLACES
  GOOGLE_REVIEWS
  SERPER_INSTAGRAM
  META_ADS_LIBRARY
  BRASIL_API
  WEBSITE_PROBE
  LINKTREE_RESOLVE
  APIFY
}

// Append-only. Nunca UPDATE. Se o payloadHash repetir, descarta sem
// escrever — é o que torna o diff trivial e a coleta barata.
model Observation {
  id          String            @id @default(cuid())
  canonicalId String
  canonical   CanonicalBusiness @relation(fields: [canonicalId], references: [id], onDelete: Cascade)

  source      ObservationSource
  payload     Json
  payloadHash String
  observedAt  DateTime          @default(now())

  // Qual tenant provocou a coleta — para atribuição de custo e billing.
  // Nunca sai da camada de dados.
  triggeredByTenantId String?

  @@unique([canonicalId, source, payloadHash])
  @@index([canonicalId, source, observedAt])
  @@map("observations")
}

// Os quatro eixos do produto. A ordem é fixa na UI: dor, dinheiro,
// momento, alcance.
enum SignalAxis {
  DOR
  DINHEIRO
  MOMENTO
  ALCANCE
}

// Os tipos de sinais agora são Strings geradas dinamicamente pela IA.
// Mantemos algumas documentadas por convenção, mas não engessadas.

// Derivado do diff entre observações consecutivas. É o ativo real do
// produto e a fonte do feed.
model Signal {
  id          String            @id @default(cuid())
  canonicalId String
  canonical   CanonicalBusiness @relation(fields: [canonicalId], references: [id], onDelete: Cascade)

  type     String
  axis     SignalAxis
  value    Json?
  evidence Json?
  source   ObservationSource

  // Quando o mundo mudou — não quando nós percebemos. Sem isto não há
  // "começou a anunciar há 16 dias".
  observedAt DateTime
  detectedAt DateTime @default(now())
  confidence Float    @default(1)

  @@index([canonicalId, observedAt])
  @@index([type, observedAt])
  @@index([axis, observedAt])
  @@map("signals")
}

// O "conferido": cada campo carrega valor, confiança e quantas
// observações independentes o confirmaram. Telefone visto três vezes
// em datas diferentes vale mais que telefone raspado uma vez.
model CanonicalField {
  id          String            @id @default(cuid())
  canonicalId String
  canonical   CanonicalBusiness @relation(fields: [canonicalId], references: [id], onDelete: Cascade)

  key            String
  value          String
  source         ObservationSource
  confidence     Float             @default(0.5)
  confirmations  Int               @default(1)
  contradictions Int               @default(0)

  firstSeenAt     DateTime @default(now())
  lastConfirmedAt DateTime @default(now())

  @@unique([canonicalId, key, value])
  @@index([canonicalId, key])
  @@map("canonical_fields")
}

// ─── CÉREBRO GLOBAL DE INTEL DE OUTBOUND & ESTRATÉGIAS ───────────────

enum OutboundStrategyCategory {
  OUTBOUND_PITCH_ROI
  OUTBOUND_PITCH_BRAND
  OUTBOUND_PITCH_AUDIT
  OUTBOUND_PITCH_QUICK_MEETING
  OUTBOUND_EVENT_TRIGGER
}

model GlobalOutboundMetric {
  id           String                   @id @default(cuid())
  category     OutboundStrategyCategory
  niche        String
  region       String?
  hasWebsite   Boolean
  hasActiveAds Boolean

  totalAttempts         Int   @default(0)
  totalResponses        Int   @default(0)
  totalMeetingsSet      Int   @default(0)
  responseRate          Float @default(0.0)
  meetingConversionRate Float @default(0.0)
  frictionScore         Float @default(3.0)

  optimalWordCount Int      @default(60)
  topHookPhrases   Json?
  updatedAt        DateTime @updatedAt

  @@unique([category, niche, hasWebsite, hasActiveAds])
  @@index([niche, category])
  @@map("global_outbound_metrics")
}

model OutboundOutcomeLog {
  id           String                   @id @default(cuid())
  tenantId     String
  category     OutboundStrategyCategory
  niche        String
  hasWebsite   Boolean
  hasActiveAds Boolean
  outcome      String
  wordCount    Int?
  createdAt    DateTime                 @default(now())

  @@index([category, niche])
  @@map("outbound_outcome_logs")
}

// ─── MATRIZ DE INDICADORES DE APRENDIZADO DE OUTBOUND (5 CAMADAS) ───

enum GatekeeperBypassStrategy {
  GK_DIRECT_DECISION_MAKER
  GK_TECHNICAL_PARTNER
  GK_SCHEDULED_REASON
  GK_LOW_FRICTION_QUESTION
}

enum PainPointCategory {
  PAIN_WASTED_AD_SPEND
  PAIN_REFERRAL_DEPENDENCY
  PAIN_COMPETITOR_DOMINANCE
  PAIN_LOW_CONVERSION_LEADS
  PAIN_POOR_DIGITAL_AUTHORITY
}

enum ObjectionHandlingType {
  AUDIT_GAP_PROOF
  ASYNC_MICRO_DEMO
  ROI_WASTE_CALCULATION
  METHOD_DIFFERENTIATION
}

model OutboundPatternIntelligence {
  id                 String                   @id @default(cuid())
  niche              String
  gatekeeperStrategy GatekeeperBypassStrategy
  painPoint          PainPointCategory
  objectionStrategy  ObjectionHandlingType

  attemptsCount         Int   @default(0)
  gatekeeperBypassRate  Float @default(0.0)
  responseRate          Float @default(0.0)
  meetingConversionRate Float @default(0.0)

  optimalWordCount   Int   @default(65)
  winningHookPhrases Json?
  winningCTAs        Json?

  updatedAt DateTime @updatedAt

  @@unique([niche, gatekeeperStrategy, painPoint, objectionStrategy])
  @@index([niche, responseRate])
  @@map("outbound_pattern_intelligence")
}

// ─── DICIONÁRIO DE TAXONOMIA E TRADUÇÃO (AUTO-DISCOVERY) ────────────

// Dicionário global para traduzir "handlers" crus de APIs para idiomas locais
model TaxonomyDictionary {
  id        String   @id @default(cuid())
  domain    String   // Ex: "GOOGLE_PLACES_CATEGORY", "TECHNOLOGY", "SIGNAL_TYPE"
  handler   String   // Ex: "autoparts_store", "facebook_pixel"
  
  // JSONB com as traduções. Ex: { "pt-BR": "Loja de Autopeças", "es-ES": "Tienda de Repuestos" }
  translations Json   
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([domain, handler])
  @@index([domain])
  @@map("taxonomy_dictionaries")
}

// ─── LEAD LISTS (SAVED LEADS BY TENANTS) ────────────

model LeadList {
  id        String   @id @default(cuid())
  name      String
  tenantId  String?  // Opcional para listas default/globais se houver, mas atrelado ao tenant.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads     LeadListEntry[]

  @@index([tenantId])
  @@map("lead_lists")
}

model LeadListEntry {
  id         String   @id @default(cuid())
  listId     String
  businessId String
  createdAt  DateTime @default(now())

  list       LeadList          @relation(fields: [listId], references: [id], onDelete: Cascade)
  business   CanonicalBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([listId, businessId])
  @@index([listId])
  @@map("lead_list_entries")
}
