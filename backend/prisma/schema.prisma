generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  PENDING
  REVIEWED
  CONTACTED
  REJECTED
}

model Business {
  id            String   @id @default(cuid())
  placeId       String   @unique
  name          String
  address       String?
  phone         String?
  category      String?
  rating        Float?
  reviewCount   Int?
  hasWebsite    Boolean  @default(false)
  websiteUrl    String?
  googleMapsUrl String?
  latitude      Float?
  longitude     Float?
  photos        Json? // Array of photo URLs
  openingHours  String?
  searchQuery   String? // The query that found this business
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  report BusinessReport?
}

model BusinessReport {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Instagram data
  instagramUrl       String?
  instagramBio       String?
  instagramFollowers String?
  instagramPosts     Int?
  profilePicUrl      String?

  // Visual identity
  logoUrl             String?
  brandColors         Json? // Array of hex colors
  visualIdentityNotes String? @db.Text

  // AI Analysis
  aiAnalysis         Json? // Full AI analysis object
  suitabilityScore   Int? // 1-10 score
  aiSummary          String? @db.Text
  approachSuggestion String? @db.Text

  // Status tracking
  status     ReportStatus @default(PENDING)
  reviewedAt DateTime?
  notes      String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("viewer") // admin, editor, viewer
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
